<?xml version="1.0" encoding="utf-8"?>
<!-- Plus Jakarta Sans (OFL 1.1), Latin subset. Pick a weight with android:textFontWeight. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/jakarta_regular" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/jakarta_medium" android:fontStyle="normal" android:fontWeight="500" />
    <font android:font="@font/jakarta_bold" android:fontStyle="normal" android:fontWeight="700" />
    <font android:font="@font/jakarta_extrabold" android:fontStyle="normal" android:fontWeight="800" />
</font-family>
