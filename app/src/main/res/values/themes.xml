<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.News" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorEdgeEffect">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.News.Article">
        <item name="android:windowBackground">@color/surface</item>
    </style>
</resources>
