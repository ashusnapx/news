<?xml version="1.0" encoding="utf-8"?>
<!-- First launch only: one question, then out of the way for good. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/welcome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/welcomeBody"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:text="@string/wave"
            android:textSize="52sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityHeading="true"
            android:fontFamily="@font/instrument_serif"
            android:text="@string/welcome_title"
            android:textColor="@color/ink"
            android:textSize="44sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/welcome_ask"
            android:textColor="@color/ink2"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:autofillHints="personGivenName"
            android:background="@drawable/field"
            android:hint="@string/welcome_hint"
            android:imeOptions="actionDone"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="30"
            android:paddingHorizontal="18dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink2"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/nameGo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/quiz_card"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:stateListAnimator="@animator/press"
            android:text="@string/welcome_go"
            android:textColor="#FFFFFF"
            android:textFontWeight="700"
            android:textSize="15.5sp" />

        <TextView
            android:id="@+id/nameSkip"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/welcome_skip"
            android:textColor="@color/ink2"
            android:textFontWeight="500"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
