<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="14dp"
        android:layoutAnimation="@anim/list_enter"
        android:listSelector="@android:color/transparent"
        android:scrollbars="none" />

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/top_scrim" />

    <!-- Floating bottom bar: Prelims and Mains switch the feed, Quiz opens today's quiz. -->
    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/nav_bar"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp">

        <include android:id="@+id/navPrelims" layout="@layout/nav_item" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <include android:id="@+id/navMains" layout="@layout/nav_item" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <include android:id="@+id/navQuiz" layout="@layout/nav_item" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
    </LinearLayout>

    <include layout="@layout/welcome" />
</FrameLayout>
