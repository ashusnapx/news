<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@color/line"
                android:foreground="@drawable/hero_scrim"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:transitionName="hero" />

            <LinearLayout
                android:id="@+id/sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-28dp"
                android:background="@drawable/sheet"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp">

                <HorizontalScrollView
                    android:id="@+id/toggleScroll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/track"
                        android:orientation="horizontal"
                        android:padding="4dp" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:fontFamily="@font/instrument_serif"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/ink"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/ink2"
                    android:textFontWeight="500"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/listen" style="@style/Action" android:drawableStart="@drawable/ic_listen" android:text="@string/listen" />
                    <TextView android:id="@+id/save" style="@style/Action" android:drawableStart="@drawable/ic_save" android:text="@string/save" />
                    <TextView android:id="@+id/share" style="@style/Action" android:drawableStart="@drawable/ic_share" android:text="@string/share" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Up next: the swipe made visible. -->
            <FrameLayout
                android:id="@+id/nextWrap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/upNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card"
                    android:baselineAligned="false"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:stateListAnimator="@animator/press">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.12"
                            android:text="@string/up_next"
                            android:textColor="@color/accent"
                            android:textFontWeight="700"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/nextTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/ink"
                            android:textFontWeight="700"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/nextThumb"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/thumb">

                        <ImageView
                            android:id="@+id/nextImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:background="@color/surface"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:textFontWeight="700"
        android:importantForAccessibility="no"
        android:minHeight="56dp"
        android:paddingStart="72dp"
        android:paddingEnd="20dp"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textSize="15sp" />

    <!-- Reading progress, in the selected coaching's colour. -->
    <View
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:scaleX="0"
        android:transformPivotX="0dp" />

    <!-- Shown while text is selected: the floating menu tucks Highlight behind its overflow. -->
    <TextView
        android:id="@+id/highlightPill"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/quiz_card"
        android:elevation="10dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:text="@string/highlight_pill"
        android:textColor="#FFFFFF"
        android:textFontWeight="700"
        android:textSize="15sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/paperBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/round_btn"
        android:contentDescription="@string/to_paper"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_paper" />

    <ImageButton
        android:id="@+id/back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        android:background="@drawable/round_btn"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_back" />
</FrameLayout>
