<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/round_btn"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/step"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:ellipsize="end"
                android:letterSpacing="0.12"
                android:singleLine="true"
                android:textColor="@color/accent"
                android:textFontWeight="700"
                android:textSize="11.5sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/track"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/track_strong">

            <View
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/accent"
                android:scaleX="0"
                android:transformPivotX="0dp" />
        </FrameLayout>

        <!-- The deck: two ghost cards behind the live one thin out as questions run down. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="34dp"
            android:layout_weight="1"
            android:clipChildren="false">

            <View
                android:id="@+id/ghost2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.45"
                android:background="@drawable/flashcard"
                android:scaleX="0.88"
                android:scaleY="0.88"
                android:translationY="34dp" />

            <View
                android:id="@+id/ghost1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.75"
                android:background="@drawable/flashcard"
                android:scaleX="0.94"
                android:scaleY="0.94"
                android:translationY="17dp" />

            <FrameLayout
                android:id="@+id/card"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ScrollView
                    android:id="@+id/front"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/flashcard"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:id="@+id/question"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/ink"
                            android:textFontWeight="500"
                            android:textSize="18sp" />

                        <LinearLayout
                            android:id="@+id/options"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </ScrollView>

                <ScrollView
                    android:id="@+id/back_face"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/verdict"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="assertive"
                            android:fontFamily="@font/instrument_serif"
                            android:includeFontPadding="false"
                            android:textSize="40sp" />

                        <TextView
                            android:id="@+id/answer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/ink"
                            android:textFontWeight="700"
                            android:textSize="15.5sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="20dp"
                            android:background="@color/line" />

                        <TextView
                            android:id="@+id/whyLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.14"
                            android:text="@string/quiz_why"
                            android:textColor="@color/ink2"
                            android:textFontWeight="700"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/why"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/literata_regular"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/ink"
                            android:textSize="15.5sp" />

                        <TextView
                            android:id="@+id/moreToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:text="@string/quiz_more"
                            android:textColor="@color/accent"
                            android:textFontWeight="700"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/more"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/literata_regular"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/ink2"
                            android:textSize="14.5sp"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/quiz_flip"
                            android:textColor="@color/ink2"
                            android:textSize="12sp" />
                    </LinearLayout>
                </ScrollView>
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/next"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/quiz_card"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:stateListAnimator="@animator/press"
            android:textColor="#FFFFFF"
            android:textFontWeight="700"
            android:textSize="15.5sp"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/result"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_serif"
            android:textColor="@color/accent"
            android:textSize="112sp" />

        <TextView
            android:id="@+id/verdictAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/instrument_serif"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/done"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/quiz_card"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="40dp"
            android:stateListAnimator="@animator/press"
            android:text="@string/quiz_done"
            android:textColor="#FFFFFF"
            android:textFontWeight="700"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
