<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Intro: pick a set. -->
            <LinearLayout
                android:id="@+id/intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="@string/quiz_label"
                    android:textColor="@color/accent"
                    android:textFontWeight="700"
                    android:textSize="11.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityHeading="true"
                    android:fontFamily="@font/instrument_serif"
                    android:text="@string/prelims_mode"
                    android:textColor="@color/ink"
                    android:textSize="46sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/literata"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/prelims_rules"
                    android:textColor="@color/ink2"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:letterSpacing="0.14"
                    android:text="@string/choose_set"
                    android:textColor="@color/ink2"
                    android:textFontWeight="700"
                    android:textSize="11.5sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/sets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/track_strong"
                        android:orientation="horizontal"
                        android:padding="4dp" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/start"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/quiz_card"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:stateListAnimator="@animator/press"
                    android:textColor="#FFFFFF"
                    android:textFontWeight="700"
                    android:textSize="15.5sp" />
            </LinearLayout>

            <!-- Play. -->
            <LinearLayout
                android:id="@+id/play"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/step"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        android:ellipsize="end"
                        android:letterSpacing="0.12"
                        android:singleLine="true"
                        android:textColor="@color/accent"
                        android:textFontWeight="700"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/track_strong"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/ink"
                        android:textFontWeight="700"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/marks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:fontFamily="@font/instrument_serif"
                        android:textColor="@color/ink"
                        android:textSize="28sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/board"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="12dp"
                    android:importantForAccessibility="no"
                    android:orientation="horizontal" />

                <FrameLayout
                    android:id="@+id/paceTrack"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/track_strong"
                    android:importantForAccessibility="no">

                    <View
                        android:id="@+id/pace"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/accent"
                        android:transformPivotX="0dp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/ink"
                    android:textFontWeight="500"
                    android:textSize="18.5sp" />

                <LinearLayout
                    android:id="@+id/options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rule_out_hint"
                    android:textColor="@color/ink2"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/whyBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/why_box"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/verdict"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="assertive"
                        android:fontFamily="@font/instrument_serif"
                        android:includeFontPadding="false"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/answer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/ink"
                        android:textFontWeight="700"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/why"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/literata"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/ink"
                        android:textSize="15.5sp" />

                    <TextView
                        android:id="@+id/moreToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:text="@string/quiz_more"
                        android:textColor="@color/accent"
                        android:textFontWeight="700"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/more"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/literata"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/ink2"
                        android:textSize="14.5sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- "+2" / "−0.66" rising from the tapped option. -->
    <TextView
        android:id="@+id/floater"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/instrument_serif"
        android:importantForAccessibility="no"
        android:textSize="34sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/skip"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/skip_btn"
            android:gravity="center"
            android:stateListAnimator="@animator/press"
            android:text="@string/skip"
            android:textColor="@color/ink"
            android:textFontWeight="700"
            android:textSize="15.5sp" />

        <TextView
            android:id="@+id/next"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/quiz_card"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:stateListAnimator="@animator/press"
            android:textColor="#FFFFFF"
            android:textFontWeight="700"
            android:textSize="15.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        android:background="@drawable/round_btn"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_back" />

    <ScrollView
        android:id="@+id/result"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/resultPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="@string/your_marks"
                android:textColor="@color/ink2"
                android:textFontWeight="700"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/instrument_serif"
                android:textColor="@color/accent"
                android:textSize="96sp" />

            <TextView
                android:id="@+id/outOf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink2"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/recap"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="26dp"
                android:importantForAccessibility="no"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/ink"
                android:textFontWeight="500"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/verdictAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/instrument_serif"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/again"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/skip_btn"
                android:gravity="center"
                android:stateListAnimator="@animator/press"
                android:text="@string/another_set"
                android:textColor="@color/ink"
                android:textFontWeight="700"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/done"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/quiz_card"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:stateListAnimator="@animator/press"
                android:text="@string/quiz_done"
                android:textColor="#FFFFFF"
                android:textFontWeight="700"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
