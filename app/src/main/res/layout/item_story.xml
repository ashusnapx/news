<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card"
    android:baselineAligned="false"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="124dp"
    android:orientation="horizontal"
    android:padding="14dp"
    android:stateListAnimator="@animator/press">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sources"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/ink2"
            android:textFontWeight="500"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="@color/ink"
            android:textFontWeight="700"
            android:textSize="16.5sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/thumb"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginStart="14dp"
        android:background="@drawable/thumb">

        <TextView
            android:id="@+id/mono"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/instrument_serif"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/on_src"
            android:textSize="48sp" />

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:transitionName="hero" />
    </FrameLayout>
</LinearLayout>
