<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="0dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.14"
            android:textColor="@color/accent"
            android:textFontWeight="700"
            android:textSize="11.5sp" />

        <ImageButton
            android:id="@+id/refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/round_btn"
            android:contentDescription="@string/refresh"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:accessibilityHeading="true"
        android:fontFamily="@font/instrument_serif"
        android:includeFontPadding="false"
        android:text="@string/brief"
        android:textColor="@color/ink"
        android:textSize="52sp" />

    <TextView
        android:id="@+id/state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/instrument_serif"
        android:textColor="@color/ink"
        android:textSize="30sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:accessibilityLiveRegion="polite"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/ink2"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/quizCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/quiz_card"
        android:foreground="?android:attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="20dp"
        android:stateListAnimator="@animator/press"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.14"
            android:text="@string/quiz_label"
            android:textColor="#CCFFFFFF"
            android:textFontWeight="700"
            android:textSize="11.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quizTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/instrument_serif"
                android:textColor="#FFFFFF"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/start_pill"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/quiz_start"
                android:textColor="@color/accent"
                android:textFontWeight="700"
                android:textSize="13.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/quizMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#D9FFFFFF"
            android:textFontWeight="500"
            android:textSize="12.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/track_strong"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/readRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/readText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/ink2"
            android:textFontWeight="700"
            android:textSize="12.5sp" />

        <FrameLayout
            android:id="@+id/readTrack"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/track_strong">

            <View
                android:id="@+id/readBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/accent"
                android:scaleX="0"
                android:transformPivotX="0dp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
