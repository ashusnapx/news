<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="16dp">

    <!-- Greeting on the left, today's quiz on the right; equal heights. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/greetCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/greet_card"
            android:foreground="?android:attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="18dp"
            android:stateListAnimator="@animator/press">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/greetEmoji"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:textSize="24sp" />

                <ImageButton
                    android:id="@+id/refresh"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/refresh"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_refresh" />
            </LinearLayout>

            <TextView
                android:id="@+id/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.12"
                android:textColor="@color/accent"
                android:textFontWeight="700"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/greetHello"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ink2"
                android:textFontWeight="500"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/greetName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/instrument_serif"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/ink"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/greetLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/accent"
                android:textFontWeight="700"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quizCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/quiz_card"
            android:foreground="?android:attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="18dp"
            android:stateListAnimator="@animator/press"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="@string/quiz_label"
                android:textColor="#CCFFFFFF"
                android:textFontWeight="700"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/quizTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/instrument_serif"
                android:includeFontPadding="false"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/quizMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#D9FFFFFF"
                android:textFontWeight="500"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/start_pill"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/quiz_start"
                android:textColor="@color/accent"
                android:textFontWeight="700"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Only when there is something to say: first load, offline, nothing published. -->
    <TextView
        android:id="@+id/state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/instrument_serif"
        android:textColor="@color/ink"
        android:textSize="30sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        android:accessibilityLiveRegion="polite"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/ink2"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/track_strong"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/readRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/readText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/ink2"
            android:textFontWeight="700"
            android:textSize="12.5sp" />

        <FrameLayout
            android:id="@+id/readTrack"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/track_strong">

            <View
                android:id="@+id/readBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/accent"
                android:scaleX="0"
                android:transformPivotX="0dp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
