<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="16dp">

    <!-- One line of greeting, one of context; long-press to change the name. -->
    <LinearLayout
        android:id="@+id/greetRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="0dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:fontFamily="@font/instrument_serif"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textSize="27sp" />

            <TextView
                android:id="@+id/greetSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/ink2"
                android:textFontWeight="500"
                android:textSize="13sp" />
        </LinearLayout>

        <com.ashusnapx.news.Ring
            android:id="@+id/ring"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_you" />
    </LinearLayout>

    <!-- GS paper filter for the current tab. -->
    <HorizontalScrollView
        android:id="@+id/gsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/gsChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/track_strong"
            android:orientation="horizontal"
            android:padding="4dp" />
    </HorizontalScrollView>

    <!-- Only when there is something to say: first load, offline, nothing published. -->
    <TextView
        android:id="@+id/state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/instrument_serif"
        android:textColor="@color/ink"
        android:textSize="30sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        android:accessibilityLiveRegion="polite"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/ink2"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/readRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/readText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/ink2"
            android:textFontWeight="700"
            android:textSize="12.5sp" />

        <FrameLayout
            android:id="@+id/readTrack"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/track_strong">

            <View
                android:id="@+id/readBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/accent"
                android:scaleX="0"
                android:transformPivotX="0dp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
