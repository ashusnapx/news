<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="@font/instrument_serif"
                android:textColor="@color/ink"
                android:textSize="44sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.ashusnapx.news.Ring
                    android:id="@+id/ring"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/you_goal_hint" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/instrument_serif"
                        android:textColor="@color/ink"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/goalText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/ink"
                        android:textFontWeight="700"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/you_goal_hint"
                        android:textColor="@color/ink2"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/Label" android:text="@string/weeks_label" />

            <com.ashusnapx.news.Heatmap
                android:id="@+id/heat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:importantForAccessibility="no" />

            <TextView style="@style/Label" android:text="@string/deck_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/deckText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/ink"
                    android:textFontWeight="500"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/revise"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/quiz_card"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:stateListAnimator="@animator/press"
                    android:text="@string/revise_now"
                    android:textColor="#FFFFFF"
                    android:textFontWeight="700"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <TextView android:id="@+id/savedLabel" style="@style/Label" />

            <LinearLayout
                android:id="@+id/savedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView android:id="@+id/highlightsLabel" style="@style/Label" />

            <LinearLayout
                android:id="@+id/highlightList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        android:background="@drawable/round_btn"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_back" />
</FrameLayout>
