<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The only permission. Normal level: no prompt, nothing else requested. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:intentMatchingFlags="enforceIntentFilter"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.News"
        android:usesCleartextTraffic="false"
        tools:ignore="DataExtractionRules"
        tools:targetApi="36">

        <!-- No usage metrics sent from the in-app WebView. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ArticleActivity"
            android:exported="false"
            android:theme="@style/Theme.News.Article" />

        <activity
            android:name=".QuizActivity"
            android:exported="false" />

        <!-- Handles its own rotation: turning to fit the picture must not reload it. -->
        <activity
            android:name=".ImageActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:theme="@style/Theme.News.Viewer" />
    </application>
</manifest>
